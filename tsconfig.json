{
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noEmit": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2023",
        "types": ["bun", "node"],
        "verbatimModuleSyntax": true
    },
    "include": [
        "shared/**/*.ts",
        "settings/**/*.ts",
        "git/**/*.ts",
        "cli/**/*.ts",
        "desktop/**/*.ts",
        "desktop/**/*.tsx",
        "electron.vite.config.ts"
    ]
}
