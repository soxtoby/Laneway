{
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noEmit": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2023",
        "types": ["bun", "node"],
        "verbatimModuleSyntax": true
    },
    "include": [
        "shared/**/*.ts",
        "cli/**/*.ts",
        "desktop/**/*.ts",
        "electron.vite.config.ts"
    ]
}
