diff --git a/dist/utils/createDOMNode.js b/dist/utils/createDOMNode.js
new file mode 100644
index 0000000000000000000000000000000000000000..764e84bf579c6cf6e6d115033b90066ad31ec9a6
--- /dev/null
+++ b/dist/utils/createDOMNode.js
@@ -0,0 +1,24 @@
+// Apply Pierre's trusted HAST through DOM/CSSOM APIs under a strict style CSP.
+export function createDOMNode(node, svg = false) {
+    if (node.type === "text") return document.createTextNode(node.value);
+    if (node.type === "comment") return document.createComment(node.value);
+    svg = svg || node.tagName === "svg";
+    const element = svg ? document.createElementNS("http://www.w3.org/2000/svg", node.tagName) : document.createElement(node.tagName);
+    for (const [key, value] of Object.entries(node.properties ?? {})) {
+        if (value == null || value === false) continue;
+        if (key === "style") {
+            element.style.cssText = String(value);
+            continue;
+        }
+        const name = key === "className" ? "class" : svg && key !== "viewBox" && key !== "preserveAspectRatio"
+            ? key.replace(/[A-Z]/g, letter => "-" + letter.toLowerCase()) : key;
+        element.setAttribute(name, Array.isArray(value) ? value.join(" ") : value === true ? "" : String(value));
+    }
+    element.append(...node.children.map(child => createDOMNode(child, svg && node.tagName !== "foreignObject")));
+    return element;
+}
+export function insertHast(element, position, children) {
+    const nodes = children.map(node => createDOMNode(node));
+    if (position === "afterbegin") element.prepend(...nodes);
+    else element.append(...nodes);
+}
