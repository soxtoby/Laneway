{
    "lineWidth": 160,
    "newLineKind": "lf",
    "useTabs": false,
    "indentWidth": 4,
    "includes": [
        "**/*.{ts,tsx,js,jsx,json,jsonc,css,html}"
    ],
    "typescript": {
        "semiColons": "asi",
        "useBraces": "preferNone",
        "quoteStyle": "preferDouble",
        "singleBodyPosition": "nextLine",
        "exportDeclaration.forceSingleLine": true,
        "importDeclaration.forceSingleLine": true,
        "jsxAttributes.preferSingleLine": true,
        "arrayExpression.preferSingleLine": true,
        "arrowFunction.useParentheses": "preferNone"
    },
    "excludes": [
        "**/node_modules/**",
        "bun.lock",
        "cli/bin/**",
        "desktop/out/**",
        "prototype/**"
    ],
    "plugins": [
        "npm:@dprint/typescript@0.96.1",
        "npm:@dprint/json@0.25.2",
        "npm:dprint-plugin-malva@0.16.0",
        "npm:dprint-plugin-markup@0.27.6"
    ]
}
